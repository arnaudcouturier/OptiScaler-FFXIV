<?xml version="1.0" encoding="utf-8"?>
<!--
  Engine pass override shaders (ext\ffxiv\engine\shaders\CbScale.hlsl). One compute shader, compiled by fxc -O3 into a header in
  $(IntDir)ext_gen\ (never committed). The register slots and the constant-buffer layout in the .hlsl are mirrored by CbPatch.cpp;
  change them together.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ExtShader Include="$(MSBuildThisFileDirectory)shaders\CbScale.hlsl">
      <Variable>CbScale_CS_cso</Variable>
      <Header>CbScale_CS.h</Header>
      <Profile>cs_5_0</Profile>
      <Entry>CSMain</Entry>
    </ExtShader>
  </ItemGroup>
</Project>
