@{
    Class       = 'cpu'
    Note        = 'Light shaft rules (ext/ffxiv/engine/ShaftsRules.h) and the anchors they run on: every key off or at today''s picture by default, a NaN or out-of-range value never turning the pass on, the master switch at intensity 0 running nothing, the render window and its half-resolution extent (an odd extent keeps its last half pixel), the reversed-Z sky test (the far plane is 0, a NaN is a surface), the sun''s projection through the engine''s own row-major column-vector projection (centre, edges, behind the camera, exactly on the camera''s plane, past the off-screen margin, and a direction that is not a unit vector), the projection''s own shape check, the sun light rule (a directional light beats a brighter lamp, a draw without the depth or the camera is never a candidate), the sun colour rule with the live build''s zero diffuse, the whole tone-map shape (both FP16 sizes, an 8-bit target, a scene written in place, a t0 that is not the scene, a window that does not fit), the light and tone-map anchors with their own slot fields and refusal streak (a shafts refusal never stands the two knobs down), and the log and cost lines, the frame''s directional shadow as the identity a light has to pass (the captured 128-byte row at +0x20 negated and normalised is that frame''s sun to 1e-4 degrees, the 48.9-degree yawed light and a mirror light are refused, a same-size neighbour without the matrix''s shape is never judged, no such buffer is Missing and never a refusal, and the other-sign layout is named); the white point''s band (a live exposure is clamped to the measured 0.838 ceiling and the dark end, a wrong-but-in-range exposure no longer pushes a channel past the frame''s white, the fallback at the dark end on a dusk frame is 14 % of its white where the measured value was 81 %, and a white point more than ninety frames old is not this frame''s); and the held sun''s six weights, each step at most a fifth of the light, driven through a frame sequence, plus the card''s rendered-frame count, its held count and its fifth reason'
    Sources     = @('shafts_rules.cpp')
    IncludeDirs = @('{repo}/OptiScaler')
    Defines     = @('NOMINMAX')
    Std         = 'c++20'
}
