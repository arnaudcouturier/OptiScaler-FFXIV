@{
    Class       = 'warp'
    Note        = 'Puddles pass on D3D11 WARP with the real shaders and the real Pass class on synthetic buffers: on the floor the chosen channel follows a CPU reference of the same formula within one 8-bit step (a yawed, offset camera, so the inverse view''s rotation and its translation are both on the path) and the other three channels are the engine''s own bits at every texel, the wall and the sky above the floor''s horizon are byte for byte the engine''s texel, a wetness of 0 and a coverage of 0 are both a pure copy of the whole target, the wetness the shader gates on is the knob''s forced amount while the knob is armed (the engine''s buffer at 0 with the knob at 1.0 shapes the full-rain picture, and the knob at 0.0 over a wet engine is a pure copy, so the forced amount and not the unpatched copy is what the shape follows), the engine''s own amount is read back for the run line with a no-wait map of a staging copy an earlier frame took, a sky texel whose normal points up but whose depth is cleared keeps the engine''s texel (the depth is what says there is no surface), the threshold follows the engine''s wetness at half rain and half coverage against the reference, the channel key moves the change to the channel it names (green here, with red, blue and alpha untouched), a target larger than the render window leaves every texel outside it byte for byte the engine''s while the window still matches the reference, the engine''s half-pixel viewport origin leaves the first texel row and column of the window alone, two runs of a still scene are byte for byte identical and reuse the one owned target while a size change - a width-only one included - creates one more, the region the pass draws and the shader''s own region test are pinned as the pair that protects the engine''s texels outside the window, the camera layout check passes on a real camera table and refuses a table that is not one (the pass then returns null and reports the refusal), and a run the pure rules refuse returns null so the caller keeps the engine''s own texture'
    Prepare     = 'prepare_gloss_puddles.ps1'
    Sources     = @('gloss_puddles_warp.cpp', '{repo}/OptiScaler/ext/ffxiv/engine/GlossPuddlesPass.cpp')
    IncludeDirs = @('stubs', '{repo}/OptiScaler', '{out}')
    Args        = @('{repo}')
    Libs        = @('d3d11.lib', 'dxgi.lib')
    Defines     = @('NOMINMAX')
    Std         = 'c++latest'
}
