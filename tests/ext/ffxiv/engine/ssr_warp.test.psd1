@{
    Class       = 'warp'
    Note        = 'Screen-space reflections pass (ext/ffxiv/engine/SsrPass.cpp and shaders/Ssr.hlsl) on D3D11 WARP against a CPU reference of the same march: a floor below a bright square on a wall shows the square''s colour with a confidence above one half, a texel whose ray leaves the picture keeps the engine''s own texel byte for byte - both in a window at the allocation''s origin and in one placed away from it whose texels outside the window hold a surface the picture does not show (a march that kept going could reflect it), a floor with nothing above it and a blend of 0 are the engine''s map byte for byte, the whole written region matches the reference texel by texel (mapping, march, refinement, edge fade and blend together), every texel outside the quadrant keeps all four of the engine''s channels, the tuning reaches the picture (48 steps against 16), two runs of a still scene are byte-identical and a size change creates a new pair of owned targets, a camera roll of twenty degrees reaches the GPU (the camera table is rewritten for every case) and the rolled region matches a reference whose water plane comes from ground points put through the view matrix rather than from the column the shader extracts, two rolls of one scene are not the same picture, the scene is copied while bound as a render target and the game''s own view is back afterwards, the copy''s box is the pure rule''s rather than the window''s rounded size, a reset gives back the scene copy''s render-target view with the copy itself (both accessors read null after it, and a run after it builds its own pair again), the replay marker is read before the frame''s one attempt and before the slot swap and the gate is handed it as the draw''s own fact, the region the pass draws and the shader''s own region test are pinned as the pair that protects the engine''s texels outside the window, the two rules a picture cannot separate from their absence are pinned at their statements (the plane''s turn to the camera''s side, and the march''s stop where the ray leaves the window: a hit outside the window has no confidence), the water plane''s normal is turned to the camera''s side and the scene above the camera matches its reference (a camera under the plane), the timestamp pair is begun and ended once per timed run and its measurement lands, a run the rules refuse returns null, a shader compiled with the water names is parsed, stamped on a real shader object and read back with its three slots and its water flag,, the slots stamped on a pixel shader object are read back unchanged after two thousand more shaders are created while an unstamped object reads the empty word, and the draw path itself is driven on the device: a compiled water shader at the capture''s own slots (map t8, view position t0, camera b2, wave map t4, caustics t6) passed through the creation hook''s stamp is served by the frame''s first water draw with this module''s texture bound for that one draw and the game''s view back afterwards (one run, one reader), the same shader with its stamp never written is passed on with the no-stamp reason counted, and a card that is not armed is passed on with the not-armed reason counted and no refusal counted at all'
    Sources     = @('ssr_warp.cpp',
                    '{repo}/OptiScaler/ext/ffxiv/engine/SsrApply.cpp',
                    '{repo}/OptiScaler/ext/ffxiv/engine/SsrPass.cpp',
                    '{repo}/OptiScaler/ext/ffxiv/engine/SsrSwap.cpp')
    IncludeDirs = @('stubs', '{repo}/OptiScaler', '{out}')
    Args        = @('{repo}')
    Libs        = @('d3d11.lib', 'dxgi.lib', 'd3dcompiler.lib', 'user32.lib')
    Defines     = @('NOMINMAX')
    Std         = 'c++latest'
    Prepare     = 'prepare_ssr.ps1'
}
